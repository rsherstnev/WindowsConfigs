Locale=ru_RU
Charset=UTF-8
Language=ru
ThemeFile=flat-ui
Transparency=off
CursorType=underscore
Font=Cascadia Mono SemiBold
FontHeight=10
FontWeight=600
FontSmoothing=full
CtrlShiftShortcuts=no
Columns=180
Rows=45
ScrollbackLines=100000
PgUpDnScroll=yes
BellType=0
ConfirmExit=no
BackspaceSendsBS=yes
DeleteSendsDEL=no
CursorBlinks=yes
Term=xterm-256color
ThemeDark=helmholtz
